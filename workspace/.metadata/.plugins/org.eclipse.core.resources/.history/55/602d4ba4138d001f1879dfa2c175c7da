<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <title>Academic Results</title>
</head>
<body>
    <h1>Academic Results for <span th:text="${name}"></span> (Exam: <span th:text="${examtype_name}"></span>)</h1>

    <div th:if="${not #lists.isEmpty(markss)}">
        <table>
            <thead>
                <tr>
                    <th>Subject</th>
                    <th>Marks</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Tamil</td>
                    <td th:text="${marks.tamil_marks}"></td>
                </tr>
                <tr>
                    <td>English</td>
                    <td th:text="${marks.english_marks}"></td>
                </tr>
                <tr>
                    <td>Maths</td>
                    <td th:text="${marks.maths_marks}"></td>
                </tr>
                <tr>
                    <td>Science</td>
                    <td th:text="${marks.science_marks}"></td>
                </tr>
                <tr>
                    <td>Social</td>
                    <td th:text="${marks.social_marks}"></td>
                </tr>
                <tr>
                    <td>Total</td>
                    <td th:text="${marks.total}"></td>
                </tr>
                <tr>
                    <td>Average</td>
                    <td th:text="${marks.average}"></td>
                </tr>
            </tbody>
        </table>
    </div>

    <div th:if="${#lists.isEmpty(marks)}">
        <p>No results found for the selected exam type.</p>
    </div>
</body>
</html>